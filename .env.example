# Turso: `turso db show <db> --url` and `turso db tokens create <db>`
# Leave both unset locally to use a SQLite file (local.db).
TURSO_DATABASE_URL=libsql://onceover-<your-org>.turso.io
TURSO_AUTH_TOKEN=

# Any long random string. Vercel sends it to /api/cron/cleanup.
CRON_SECRET=

# Any long random string; salts hashed IPs used for the 5-tests-a-day limit.
RATE_LIMIT_SALT=

# TypeSafe (Jev) API key. When unset, a keyword heuristic stands in for Jev.
TYPESAFE_API_KEY=

# Anthropic API key, used to read uploaded images and PDFs. Without it, uploads are refused
# and users are asked to paste the text instead.
ANTHROPIC_API_KEY=

# Optional. Visit /api/bypass?token=<value> to skip the 5-a-day limit in that browser.
# Falls back to CRON_SECRET when unset; /api/bypass?off turns it off.
BYPASS_TOKEN=
